{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowResearchTrainingJobs",
      "Effect": "Allow",
      "Principal": {
        "Service": "sagemaker.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:sagemaker:eu-north-1:376129434881:training-job/*"
        }
      }
    }
  ]
}
